{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "electronics-store": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/electronics-store",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/assets"
            ],
            "styles": [
              "node_modules/ng-zorro-antd/style/index.min.css",
              "node_modules/ng-zorro-antd/layout/style/index.min.css",
              "node_modules/ng-zorro-antd/button/style/index.min.css",
              "node_modules/ng-zorro-antd/badge/style/index.min.css",
              "node_modules/ng-zorro-antd/input/style/index.min.css",
              "node_modules/ng-zorro-antd/input-number/style/index.min.css",
              "node_modules/ng-zorro-antd/select/style/index.min.css",
              "node_modules/ng-zorro-antd/checkbox/style/index.min.css",
              "node_modules/ng-zorro-antd/card/style/index.min.css",
              "node_modules/ng-zorro-antd/modal/style/index.min.css",
              "node_modules/ng-zorro-antd/message/style/index.min.css",
              "node_modules/ng-zorro-antd/pagination/style/index.min.css",
              "node_modules/ng-zorro-antd/spin/style/index.min.css",
              "node_modules/ng-zorro-antd/empty/style/index.min.css",
              "node_modules/ng-zorro-antd/form/style/index.min.css",
              "node_modules/ng-zorro-antd/segmented/style/index.min.css",
              "node_modules/ng-zorro-antd/alert/style/index.min.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "electronics-store:build:production"
            },
            "development": {
              "buildTarget": "electronics-store:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "providersFile": "src/test-providers.ts"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
